{%- comment -%}
  Expérience immersive (React + Three.js + GSAP), compilée dans assets/immersive.js.
  Le produit vendu vient de la page produit en cours, ou du produit choisi dans l'éditeur de thème.
{%- endcomment -%}
{%- liquid
  assign p = product
  if p == blank
    assign p = section.settings.product
  endif
  if p == blank
    assign p = collections.all.products.first
  endif
  assign v = p.selected_or_first_available_variant
  assign compare_price = ''
  assign discount = 0

  if v != blank
    # Ajout au panier puis page panier (case CGV / renonciation au droit de rétractation obligatoire)
    assign buy_url = routes.cart_add_url | append: '?id=' | append: v.id | append: '&quantity=1'
    assign price = v.price | money | strip_html
    # Ancien prix barré : « Prix avant réduction » de la variante, s'il est supérieur au prix actuel
    if v.compare_at_price > v.price
      assign compare_price = v.compare_at_price | money | strip_html
      assign discount = v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round
    endif
  else
    assign buy_url = routes.all_products_collection_url
    assign price = ''
  endif

  assign files = 'cover-front.jpg,book-mockup.webp,sommaire.jpg,page-11.jpg,pilier-regles.jpg,pilier-phrases.jpg,detail-tablette.jpg,affiche-plan-familial.jpg,affiche-5-temps.jpg,affiche-defi-14-jours.jpg,cartes-mode-emploi.jpg,cartes-idees.jpg,fiche-grands-parents.jpg,page-03.jpg,page-05.jpg,page-09.jpg,page-13.jpg,page-17.jpg,page-22.jpg' | split: ','
-%}

<script>
  window.__ASSETS__ = {
    {%- for f in files -%}
      {{ f | json }}: {{ f | asset_url | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  };
  window.__SHOP__ = {
    brand: {{ settings.brand_name | default: shop.name | json }},
    productUrl: {{ p.url | json }},
    menu: [
      {%- for link in linklists[settings.main_menu].links -%}
        { "title": {{ link.title | json }}, "url": {{ link.url | json }} }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    title: {{ p.title | default: shop.name | json }},
    price: {{ price | json }},
    comparePrice: {{ compare_price | json }},
    discount: {{ discount | json }},
    buyUrl: {{ buy_url | json }},
    available: {% if v.available %}true{% else %}false{% endif %},
    cartCount: {{ cart.item_count | json }},
    links: [
      {%- for link in linklists.footer.links -%}
        { "title": {{ link.title | json }}, "url": {{ link.url | json }} }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  };
</script>

{{ 'immersive.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  Téléchargés tout de suite, en parallèle du script : la police (dessinée sur les textures du livre)
  et la scène 3D. Mêmes URL sans « ?v=… » que celles qu'utilisent immersive.css et immersive.js.
{%- endcomment -%}
<link rel="preload" as="font" type="font/woff2" href="{{ 'plus-jakarta-sans-latin-wght-normal.woff2' | asset_url | split: '?' | first }}" crossorigin>
<link rel="modulepreload" href="{{ 'immersive-Experience.js' | asset_url | split: '?' | first }}">

{%- comment -%}
  Contenu rendu côté serveur (lu par les moteurs de recherche et affiché sans JavaScript).
  React le remplace par l'expérience immersive dès son chargement.
{%- endcomment -%}
<div id="root">
  {%- comment -%}
    Écran d'ouverture identique à celui de React (components/Loader.tsx), affiché dès le premier octet :
    le visiteur ne voit jamais le texte brut ci-dessous, qui reste lisible pour Google et sans JavaScript.
  {%- endcomment -%}
  {%- assign brand = settings.brand_name | default: shop.name -%}
  <div class="grain fixed inset-0 z-[100] grid place-items-center bg-navy" aria-hidden="true">
    <div class="flex w-[min(320px,70vw)] flex-col items-center text-center">
      <svg viewBox="0 0 48 48" class="loader-mark h-24 w-24 drop-shadow-[0_18px_40px_rgba(232,132,60,0.25)]">
        <rect width="48" height="48" rx="12" fill="#f4f2ec" />
        <circle class="loader-sun" cx="24" cy="15.5" r="4.5" fill="#e8843c" />
        <path class="loader-page loader-page--left" d="M8 21.5c6.2-1.6 11.6-.9 15 2.4V38c-3.4-3-8.8-3.7-15-2.2z" fill="#12283e" />
        <path class="loader-page loader-page--right" d="M40 21.5c-6.2-1.6-11.6-.9-15 2.4V38c3.4-3 8.8-3.7 15-2.2z" fill="#12283e" />
      </svg>
      {%- assign brand_words = brand | split: ' ' -%}
      <p class="mt-6 text-2xl font-extrabold tracking-tight text-paper">
        {{ brand_words.first | escape }}
        <span class="serif-accent text-[1.15em] font-normal text-ember">{{ brand_words | slice: 1, 10 | join: ' ' | escape }}</span>
      </p>
      <p class="mt-2 text-xs font-semibold tracking-[0.2em] text-paper/50 uppercase">Mon enfant et les écrans</p>
      <div class="relative mt-6 h-px w-full overflow-hidden bg-paper/15">
        <div class="absolute inset-y-0 w-1/3 animate-[loader_1.2s_ease-in-out_infinite] bg-ember/60"></div>
      </div>
    </div>
    <style>
      @keyframes loader{0%{left:-35%}100%{left:100%}}
      .loader-mark{animation:loader-breathe 2.4s ease-in-out infinite}
      .loader-sun{transform-box:fill-box;transform-origin:center;animation:loader-sun 2.4s ease-in-out infinite}
      .loader-page{transform-box:fill-box;animation:loader-page 2.4s cubic-bezier(.65,0,.35,1) infinite}
      .loader-page--left{transform-origin:right center}
      .loader-page--right{transform-origin:left center;animation-delay:.15s}
      @keyframes loader-breathe{0%,100%{transform:translateY(0)}50%{transform:translateY(-4px)}}
      @keyframes loader-sun{0%,100%{transform:translateY(5px) scale(.85);opacity:.55}50%{transform:translateY(-1px) scale(1.08);opacity:1}}
      @keyframes loader-page{0%,100%{transform:scaleX(1)}45%,55%{transform:scaleX(.55) skewY(-6deg)}}
      @media (prefers-reduced-motion: reduce){.loader-mark,.loader-sun,.loader-page{animation:none}}
    </style>
  </div>
  <main style="max-width:680px;margin:0 auto;padding:120px 20px 60px;font-family:system-ui,sans-serif;color:#f4f2ec;background:#0b1a2b">
    <p style="color:#e8843c;font-weight:700;letter-spacing:.2em;text-transform:uppercase;font-size:12px">Guide pratique pour les parents</p>
    <h1>{{ p.title | escape }}</h1>
    {%- if p.description != blank -%}<div>{{ p.description }}</div>{%- endif -%}
    <p><a href="{{ buy_url }}" style="color:#e8843c">Obtenir le guide — {% if compare_price != '' %}<s>{{ compare_price }}</s> {% endif %}{{ price }}</a></p>
    <nav aria-label="Navigation">
      {%- for link in linklists[settings.main_menu].links -%}
        <a href="{{ link.url }}" style="color:#f4f2ec;margin-right:16px">{{ link.title }}</a>
      {%- endfor -%}
    </nav>
  </main>
</div>

{%- comment -%}
  Sans « ?v=… » : immersive.js importe ses autres morceaux (scène 3D) par des chemins relatifs,
  qui doivent désigner exactement les mêmes URL. Chaque nouveau thème a son propre dossier, donc pas de cache périmé.
{%- endcomment -%}
<script type="module" src="{{ 'immersive.js' | asset_url | split: '?' | first }}"></script>

{% schema %}
{
  "name": "Expérience immersive",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Produit vendu",
      "info": "Utilisé sur la page d'accueil. Sur une page produit, c'est le produit affiché qui est vendu."
    }
  ],
  "presets": [{ "name": "Expérience immersive" }]
}
{% endschema %}
