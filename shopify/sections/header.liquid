{%- assign menu = linklists[settings.main_menu] -%}
<header class="site-header">
  <div class="container site-header__inner site-header__inner--centered">
    <div class="site-header__left">
      <a href="{{ routes.cart_url }}" class="site-header__cart site-header__cart--mobile">
        Panier
        {%- if cart.item_count > 0 %} <span class="badge">{{ cart.item_count }}</span>{% endif -%}
      </a>
      <ul class="site-nav__links" aria-label="Navigation principale">
        {%- for link in menu.links -%}
          <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
        {%- endfor -%}
      </ul>
    </div>

    <a href="{{ routes.root_url }}" class="site-header__logo" aria-label="{{ settings.brand_name | default: shop.name | escape }}, accueil">
      {% render 'logo' %}
    </a>

    <div class="site-header__right">
      <a href="{{ routes.cart_url }}" class="site-header__cart site-header__cart--desktop">
        Panier
        {%- if cart.item_count > 0 %} <span class="badge">{{ cart.item_count }}</span>{% endif -%}
      </a>
      <details class="menu-drawer">
        <summary class="menu-drawer__toggle" aria-label="Menu">
          <span aria-hidden="true"></span>
        </summary>
        <div class="menu-drawer__panel">
          <ul>
            {%- for link in menu.links -%}
              <li>
                <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
                  <small>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</small>{{ link.title }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
          <a class="btn" href="{{ routes.cart_url }}">Panier{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</a>
        </div>
      </details>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "En-tête",
  "settings": []
}
{% endschema %}
