{%- comment -%}
  Balises de référencement : titre, description, Open Graph / réseaux sociaux et données structurées (schema.org).
{%- endcomment -%}
{%- liquid
  assign brand = settings.brand_name | default: shop.name
  assign seo_title = page_title
  assign seo_description = page_description

  if template.name == 'index'
    if page_title == shop.name
      assign seo_title = settings.home_title | default: page_title
    endif
    if seo_description == blank
      assign seo_description = settings.home_description
    endif
  endif
  if seo_description == blank and template.name == 'article'
    assign seo_description = article.excerpt_or_content | strip_html | truncate: 160
  endif

  assign og_type = 'website'
  assign og_image = 'partage.jpg' | asset_url | prepend: 'https:'
  if template.name == 'article'
    assign og_type = 'article'
    if article.image
      assign og_image = article.image | image_url: width: 1600 | prepend: 'https:'
    endif
  elsif template.name == 'product'
    assign og_type = 'product'
  endif

  assign featured = product
  if featured == blank
    assign featured = all_products['mon-enfant-et-les-ecrans']
  endif
  assign show_product = false
  if featured != blank
    if template.name == 'product' or template.name == 'index'
      assign show_product = true
    endif
  endif
-%}
<title>
  {{- seo_title -}}
  {%- unless seo_title contains brand %} &ndash; {{ brand }}{% endunless -%}
  {%- if current_page != 1 %} &ndash; page {{ current_page }}{% endif -%}
</title>
{%- if seo_description != blank -%}
  <meta name="description" content="{{ seo_description | escape }}">
{%- endif -%}
<link rel="canonical" href="{{ canonical_url }}">

<meta property="og:site_name" content="{{ brand | escape }}">
<meta property="og:locale" content="fr_FR">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ seo_title | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:image" content="{{ og_image }}">
{%- if seo_description != blank -%}
  <meta property="og:description" content="{{ seo_description | escape }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ seo_title | escape }}">
{%- if seo_description != blank -%}
  <meta name="twitter:description" content="{{ seo_description | escape }}">
{%- endif -%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": {{ shop.url | append: '/#organisation' | json }},
        "name": {{ brand | json }},
        "url": {{ shop.url | json }},
        "logo": {{ 'favicon.svg' | asset_url | prepend: 'https:' | json }}
      },
      {
        "@type": "WebSite",
        "@id": {{ shop.url | append: '/#site' | json }},
        "name": {{ brand | json }},
        "url": {{ shop.url | json }},
        "inLanguage": "fr-FR",
        "publisher": { "@id": {{ shop.url | append: '/#organisation' | json }} },
        "potentialAction": {
          "@type": "SearchAction",
          "target": {{ shop.url | append: routes.search_url | append: '?q={search_term_string}' | json }},
          "query-input": "required name=search_term_string"
        }
      }
      {%- if show_product -%}
        {%- assign v = featured.selected_or_first_available_variant -%}
        ,{
          "@type": "Product",
          "name": {{ featured.title | json }},
          "description": {{ featured.description | strip_html | truncate: 500 | json }},
          "url": {{ shop.url | append: featured.url | json }},
          {%- if featured.featured_image -%}
            "image": [{{ featured.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],
          {%- endif -%}
          "brand": { "@type": "Brand", "name": {{ brand | json }} },
          "author": { "@type": "Person", "name": {{ featured.vendor | json }} },
          "offers": {
            "@type": "Offer",
            "url": {{ shop.url | append: featured.url | json }},
            "price": {{ v.price | divided_by: 100.0 | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "availability": "https://schema.org/{% if v.available %}InStock{% else %}OutOfStock{% endif %}",
            "seller": { "@id": {{ shop.url | append: '/#organisation' | json }} }
          }
        }
      {%- endif -%}
      {%- if template.name == 'article' -%}
        ,{
          "@type": "BlogPosting",
          "headline": {{ article.title | json }},
          "description": {{ seo_description | json }},
          "mainEntityOfPage": {{ shop.url | append: article.url | json }},
          {%- if article.image -%}
            "image": [{{ article.image | image_url: width: 1600 | prepend: 'https:' | json }}],
          {%- endif -%}
          "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }},
          "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }},
          "author": { "@type": "Person", "name": {{ article.author | json }} },
          "publisher": { "@id": {{ shop.url | append: '/#organisation' | json }} },
          "inLanguage": "fr-FR"
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Accueil", "item": {{ shop.url | json }} },
            { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ shop.url | append: blog.url | json }} },
            { "@type": "ListItem", "position": 3, "name": {{ article.title | json }} }
          ]
        }
      {%- endif -%}
    ]
  }
</script>
