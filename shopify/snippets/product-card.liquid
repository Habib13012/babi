{%- comment -%} Carte produit : render 'product-card', product: produit {%- endcomment -%}
<a class="product-card" href="{{ product.url }}">
  {%- if product.featured_image -%}
    {{ product.featured_image | image_url: width: 600 | image_tag: alt: product.title, loading: 'lazy' }}
  {%- endif -%}
  <div class="product-card__title">{{ product.title }}</div>
  <div class="product-card__price">{{ product.price | money }}</div>
</a>
