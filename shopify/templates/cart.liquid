<div class="container">
  <p class="eyebrow">Votre panier</p>
  <h1>Panier</h1>

  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" novalidate>
      <ul class="cart-items">
        {%- for item in cart.items -%}
          <li class="cart-item">
            {%- if item.image -%}
              {{ item.image | image_url: width: 160 | image_tag: alt: item.title, loading: 'lazy' }}
            {%- else -%}
              <span></span>
            {%- endif -%}
            <div>
              <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>
              {%- unless item.product.has_only_default_variant -%}
                <div class="muted">{{ item.variant.title }}</div>
              {%- endunless -%}
              <div class="muted">
                {%- if item.variant.compare_at_price > item.final_price -%}
                  <s class="price-old">{{ item.variant.compare_at_price | money }}</s>
                {% endif -%}
                {{ item.final_price | money }}
              </div>
              <a class="muted" href="{{ item.url_to_remove }}">Retirer</a>
            </div>
            <div>
              <label class="visually-hidden" for="qty-{{ item.key }}">Quantité</label>
              <input
                id="qty-{{ item.key }}"
                class="field cart-item__qty"
                type="number"
                name="updates[]"
                value="{{ item.quantity }}"
                min="0"
              >
            </div>
          </li>
          {%- if item.product.handle == 'mon-enfant-et-les-ecrans' -%}
            <li class="cart-bonus-row">{% render 'cart-bonus' %}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      <div class="cart-summary">
        <div>
          <div class="muted">Total</div>
          <div class="cart-summary__total">{{ cart.total_price | money_with_currency }}</div>
          {%- assign has_guide = cart.items | map: 'product' | map: 'handle' | join: ',' -%}
          {%- if has_guide contains 'mon-enfant-et-les-ecrans' -%}
            <p class="cart-summary__perks">✓ Le guide + 3 bonus offerts<br>✓ Fichiers PDF à télécharger juste après le paiement</p>
          {%- endif -%}
        </div>
        <div class="cart-checkout">
          <div class="form-row">
            <button type="submit" name="update" class="btn btn--ghost">Mettre à jour</button>
            <button type="submit" name="checkout" class="btn">Passer au paiement</button>
          </div>
          <p class="cart-note">
            Accès immédiat à vos fichiers après le paiement. En commandant, vous acceptez nos
            <a href="/pages/cgv">conditions de vente</a> et demandez la livraison immédiate du PDF,
            qui met fin au droit de rétractation.
          </p>
        </div>
      </div>
    </form>
  {%- else -%}
    <p class="muted">Votre panier est vide.</p>
    <a class="btn" href="{{ routes.root_url }}">Découvrir le guide</a>
  {%- endif -%}
</div>
