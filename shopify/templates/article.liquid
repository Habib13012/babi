<div class="container">
  <p class="eyebrow"><a href="{{ blog.url }}">{{ blog.title }}</a></p>
  <h1>{{ article.title }}</h1>
  <p class="muted">{{ article.published_at | date: format: 'date' }}</p>
  {%- if article.image -%}
    {{ article.image | image_url: width: 1400 | image_tag: alt: article.title }}
  {%- endif -%}
  <div class="rte">{{ article.content }}</div>
</div>
