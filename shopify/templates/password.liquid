{% layout 'password' %}
<div class="card">
  <p class="eyebrow">Bientôt en ligne</p>
  <h1>{{ shop.name }}</h1>
  {%- if shop.password_message != blank -%}
    <p class="muted">{{ shop.password_message }}</p>
  {%- endif -%}

  {%- form 'storefront_password' -%}
    {%- if form.errors -%}
      <p class="errors">Mot de passe incorrect.</p>
    {%- endif -%}
    <div class="form-row">
      <label class="visually-hidden" for="password">Mot de passe</label>
      <input id="password" class="field" type="password" name="password" placeholder="Mot de passe" autocomplete="current-password">
      <button class="btn" type="submit">Entrer</button>
    </div>
  {%- endform -%}
</div>
