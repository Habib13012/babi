<div class="container">
  <p class="eyebrow">Recherche</p>
  <h1>Rechercher</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="form-row">
    <label class="visually-hidden" for="q">Rechercher</label>
    <input id="q" class="field" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Votre recherche">
    <button class="btn" type="submit">Rechercher</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <p class="muted">{{ search.results_count }} résultat(s) pour « {{ search.terms | escape }} »</p>
      <div class="product-grid">
        {%- for result in search.results -%}
          {%- if result.object_type == 'product' -%}
            {% render 'product-card', product: result %}
          {%- else -%}
            <a class="product-card" href="{{ result.url }}">
              <div class="product-card__title">{{ result.title }}</div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>
