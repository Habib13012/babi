<div class="container">
  <p class="eyebrow">Journal</p>
  <h1>{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    <div class="articles">
      {%- for article in blog.articles -%}
        <article class="article-card">
          <a href="{{ article.url }}">
            {%- if article.image -%}
              {{ article.image | image_url: width: 1100 | image_tag: alt: article.title, loading: 'lazy' }}
            {%- endif -%}
            <h2>{{ article.title }}</h2>
          </a>
          <p class="muted">{{ article.published_at | date: format: 'date' }}</p>
          <div class="rte">{{ article.excerpt_or_content | strip_html | truncatewords: 40 }}</div>
        </article>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>
