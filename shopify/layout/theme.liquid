<!doctype html>
{%- liquid
  assign immersive = false
  # Expérience immersive : accueil et page du guide (modèle « product.guide »). Les autres produits ont une page classique.
  if template.name == 'index' or template.suffix == 'guide'
    assign immersive = true
  endif
-%}
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#0b1a2b">
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    {% render 'seo', product: product, article: article, blog: blog %}

    {%- unless immersive -%}
      {{ 'base.css' | asset_url | stylesheet_tag }}
    {%- endunless -%}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    {%- if immersive -%}
      {{ content_for_layout }}
    {%- else -%}
      {% section 'header' %}
      <main id="contenu" class="page" role="main">
        {{ content_for_layout }}
      </main>
      {% section 'footer' %}
    {%- endif -%}
  </body>
</html>
