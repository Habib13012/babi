<!doctype html>
{%- liquid
  assign immersive = false
  if template.name == 'index' or template.name == 'product'
    assign immersive = true
  endif
-%}
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#0b1a2b">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">

    <title>
      {{ page_title }}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:title" content="{{ page_title | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    <meta property="og:image" content="https:{{ 'book-mockup.png' | asset_url }}">

    {%- unless immersive -%}
      {{ 'base.css' | asset_url | stylesheet_tag }}
    {%- endunless -%}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">
    {%- if immersive -%}
      {{ content_for_layout }}
    {%- else -%}
      {% section 'header' %}
      <main id="contenu" class="page" role="main">
        {{ content_for_layout }}
      </main>
      {% section 'footer' %}
    {%- endif -%}
  </body>
</html>
