# ---------------------------------------------------------------
# Mode des données : "demo" (par défaut) ou "production".
# En "production", le build échoue tant que des informations
# bloquantes manquent (voir npm run check:launch).
# ---------------------------------------------------------------
STORE_DATA_MODE=demo

# URL publique canonique, sans slash final (HTTPS en production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe — clés de TEST (sk_test_ / whsec_) tant que le parcours
# n'a pas été validé de bout en bout. Ne jamais exposer côté client.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Base de commandes SQLite (doit être sur un disque persistant)
ORDERS_DB_PATH=data/orders.sqlite

# E-mails transactionnels (Resend). Sans clé : e-mails journalisés
# dans la console (développement uniquement).
RESEND_API_KEY=
EMAIL_FROM=
# Adresse qui reçoit les messages de contact et les rétractations
SELLER_NOTIFICATION_EMAIL=

# Mesure d'audience (optionnelle) — chargée uniquement après
# consentement explicite. Laisser vide pour ne rien charger.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
