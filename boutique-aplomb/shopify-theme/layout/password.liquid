<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <title>{{ shop.name }} — bientôt</title>
    <style>
      @font-face { font-family: "Fraunces"; src: url("{{ 'fraunces-latin.woff2' | asset_url }}") format("woff2"); font-weight: 100 900; font-display: swap; }
      @font-face { font-family: "Manrope"; src: url("{{ 'manrope-latin.woff2' | asset_url }}") format("woff2"); font-weight: 200 800; font-display: swap; }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>
