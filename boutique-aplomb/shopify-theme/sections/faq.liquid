<section class="page-width section" aria-labelledby="t-{{ section.id }}">
  <div class="split">
    <div class="reveal">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 id="t-{{ section.id }}" class="h2" style="margin-top: 1rem">{{ section.settings.title }}</h2>
    </div>
    <div class="faq">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="answer rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Questions fréquentes",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Questions" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Avant de commander." }
  ],
  "blocks": [ { "type": "question", "name": "Question", "settings": [
    { "type": "text", "id": "question", "label": "Question" },
    { "type": "richtext", "id": "answer", "label": "Réponse (doit correspondre aux réglages Shopify)" }
  ] } ],
  "presets": [ { "name": "Questions fréquentes", "blocks": [
    { "type": "question", "settings": { "question": "Quels ordinateurs sont compatibles ?", "answer": "<p>Les limites de taille et de poids sont indiquées dans les caractéristiques de la fiche produit. En cas de doute, écrivez-nous avec le modèle de votre ordinateur avant de commander.</p>" } },
    { "type": "question", "settings": { "question": "Puis-je retourner le produit ?", "answer": "<p>Oui. Vous disposez de 14 jours après réception pour vous rétracter, sans avoir à vous justifier. Nous vous remboursons au plus tard 14 jours après votre demande (nous pouvons attendre la réception du produit ou la preuve de son expédition).</p>" } },
    { "type": "question", "settings": { "question": "Le support soulage-t-il les douleurs de dos ou de nuque ?", "answer": "<p>Socle 01 n'est pas un dispositif médical et ne traite aucune douleur. Il permet de surélever l'écran ; pour toute douleur persistante, consultez un professionnel de santé.</p>" } },
    { "type": "question", "settings": { "question": "Le rendu 3D correspond-il exactement au produit ?", "answer": "<p>Non. Le modèle 3D est un prototype indicatif qui illustre le principe de fonctionnement. Les photos et les caractéristiques font foi.</p>" } },
    { "type": "question", "settings": { "question": "Quelle garantie s'applique ?", "answer": "<p>Vous bénéficiez de la garantie légale de conformité (2 ans à compter de la livraison) et de la garantie contre les vices cachés. Aucune garantie commerciale supplémentaire n'est proposée.</p>" } },
    { "type": "question", "settings": { "question": "Mes données bancaires sont-elles stockées ?", "answer": "<p>Non. Le paiement est traité par Shopify ; nous n'avons jamais accès à vos numéros de carte.</p>" } }
  ] } ]
}
{% endschema %}
