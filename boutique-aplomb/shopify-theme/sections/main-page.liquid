<article class="page-width section" style="padding-top: 3.5rem">
  <header class="stack-sm" style="max-width: 48rem; margin-bottom: 2.5rem">
    <h1 class="display" style="font-size: clamp(2.5rem, 2rem + 2vw, 3.75rem)">{{ page.title }}</h1>
  </header>
  <div class="rte" style="max-width: 46rem">{{ page.content }}</div>
</article>
{% schema %}
{ "name": "Contenu de page" }
{% endschema %}
