<div class="page-width section" style="text-align: center; min-height: 80vh; display: grid; place-items: center">
  <div class="stack" style="max-width: 32rem">
    <div style="width: 14rem; margin-inline: auto">{% render 'logo' %}</div>
    <p class="lead">{{ shop.password_message | default: 'Boutique en préparation.' }}</p>
    {%- form 'storefront_password', class: 'stack-sm' -%}
      {%- if form.errors -%}<div class="form-error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label class="label" for="pw">Mot de passe</label>
      <input class="field" id="pw" type="password" name="password" autocomplete="current-password">
      <button class="btn btn--primary btn--block">Entrer</button>
    {%- endform -%}
  </div>
</div>
{% schema %}
{ "name": "Page mot de passe" }
{% endschema %}
