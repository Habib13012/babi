<div class="page-width section" style="padding-top: 3.5rem">
  <h1 class="display" style="font-size: 3rem">{{ blog.title }}</h1>
  {%- paginate blog.articles by 10 -%}
    <ul class="stack" style="list-style: none; margin-top: 2rem">
      {%- for article in blog.articles -%}<li><a class="h3" href="{{ article.url }}">{{ article.title }}</a><p class="small muted">{{ article.published_at | date: '%d/%m/%Y' }}</p></li>{%- endfor -%}
    </ul>
    {{ paginate | default_pagination }}
  {%- endpaginate -%}
</div>
{% schema %}
{ "name": "Blog" }
{% endschema %}
